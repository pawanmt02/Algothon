# ===========================
# FinRadar AI - .gitignore
# ===========================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
*.egg-info/
dist/
build/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.production
.env.*.local
!.env.example
!.env.local.example

# Next.js
frontend/.next/
frontend/out/
frontend/node_modules/
frontend/.swc/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Logs
logs/
*.log

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
/tmp/
*.tmp
*.temp

# ML Model cache
*.pt
*.pth
*.bin
*.gguf
huggingface_cache/
model_cache/

# Uploaded media (don't commit test videos)
uploads/
media/
*.mp4
*.mov
*.avi
*.webm

# Vercel
.vercel
